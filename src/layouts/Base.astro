---
import '../styles/global.css';

interface Props { title?: string; description?: string; }
const {
  title = 'Javier Pato — Diseñador y creativo visual · Cantabria',
  description = 'Diseño marca y web para negocios de Cantabria, y exploro la imagen con IA como ArtiMindArt. Web de lanzamiento desde 299€.',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://javierpato.es').toString();
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#fbfaf7" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/og.webp" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Gabarito:wght@500;600;700;800;900&family=Hanken+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org', '@type': 'Person',
      name: 'Javier Pato', jobTitle: 'Diseñador y creativo visual',
      address: { '@type': 'PostalAddress', addressRegion: 'Cantabria', addressCountry: 'ES' },
      url: 'https://javierpato.es', knowsAbout: ['Diseño web', 'Branding', 'Diseño gráfico', 'Dirección de arte con IA'],
    })} />
  </head>
  <body>
    <a href="#trabajo" class="skip">Saltar al contenido</a>
    <slot />

    <script>
      const els = document.querySelectorAll('[data-reveal]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              const el = e.target as HTMLElement;
              const group = el.closest('[data-stagger]');
              if (group) {
                const i = Array.from(group.querySelectorAll('[data-reveal]')).indexOf(el);
                el.style.transitionDelay = `${i * 80}ms`;
              }
              el.classList.add('in');
              io.unobserve(el);
            }
          });
        }, { threshold: 0.12, rootMargin: '0px 0px -6% 0px' });
        els.forEach((el) => io.observe(el));
        const force = () => els.forEach((el) => { if (el.getBoundingClientRect().top < innerHeight * 0.95) el.classList.add('in'); });
        force(); addEventListener('load', force);
        setTimeout(() => els.forEach((el) => el.classList.add('in')), 1500);
      } else { els.forEach((el) => el.classList.add('in')); }

      const nav = document.querySelector('[data-nav]');
      if (nav) addEventListener('scroll', () => nav.classList.toggle('is-stuck', scrollY > 40), { passive: true });

      const clock = document.querySelector('[data-clock]');
      if (clock) {
        const t = () => clock.textContent = 'Santander ' + new Intl.DateTimeFormat('es-ES', { hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Madrid' }).format(new Date());
        t(); setInterval(t, 30000);
      }
    </script>
  </body>
</html>
