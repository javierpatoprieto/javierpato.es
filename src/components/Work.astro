---
// Trabajo · escaparate editorial: filas grandes que alternan lado, mockup
// inclinado y frase de valor honesta + sector por proyecto.
const items = [
  { title: 'Centro Infantil Periquete', slug: 'centro-infantil-periquete', url: 'centroinfantilperiquete.es', sector: 'Educación infantil', value: 'Que las familias conozcan el centro y reserven plaza sin llamadas ni líos.', status: 'Live', tone: 'rose', img: '/img/proj-periquete.webp' },
  { title: 'Fisio Mamá', slug: 'fisio-mama', url: 'fisiomama.es', sector: 'Fisioterapia · embarazo y posparto', value: 'Calma, confianza y cita online en un par de clics.', status: 'Live', tone: 'peri', img: '/img/proj-andrea.webp' },
  { title: 'Click & Cargo', slug: 'click-and-cargo', url: 'clickandcargo.com', sector: 'Logística y transporte', value: 'Una web técnica, rápida y directa al grano.', status: 'Live', tone: 'plum', img: '/img/proj-cargo.webp' },
];
---
<section id="trabajo" class="section work">
  <div class="wrap">
    <header class="work__head" data-reveal>
      <span class="work__eyebrow">2026 · Trabajo reciente</span>
      <h2 class="work__title">Marcas y negocios<br />reales que ya venden</h2>
    </header>

    <div class="work__list">
      {items.map((p) => (
        <article class={`work__item work__item--${p.tone}`} data-reveal>
          <a class="work__media" href={`/proyectos/${p.slug}`} aria-label={`${p.title} — ${p.value}`}>
            <div class="mock">
              <div class="mock__bar"><i></i><i></i><i></i><span class="mock__url">{p.url}</span></div>
              <div class="mock__body"><img src={p.img} alt={`${p.title} — diseño web en Cantabria`} loading="lazy" /></div>
            </div>
          </a>
          <div class="work__text">
            <span class="work__sector">{p.sector}</span>
            <h3 class="work__name">{p.title}</h3>
            <p class="work__value">{p.value}</p>
            <div class="work__foot">
              <span class={`work__status work__status--${p.tone}`}>● {p.status}</span>
              <a href={`/proyectos/${p.slug}`} class="work__cta">Ver el caso →</a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .work { background: var(--t-warm); }
  .work__head { margin-bottom: var(--s-7); max-width: 60ch; }
  .work__eyebrow { font-family: var(--font-body); font-weight: 600; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.12em; color: var(--accent-ink); }
  .work__title { font-size: var(--fs-h2); color: var(--ink); font-weight: 800; line-height: 1.0; margin-top: 12px; }

  .work__list { display: grid; gap: clamp(48px, 8vw, 110px); }
  .work__item { display: grid; grid-template-columns: 1fr; gap: clamp(22px, 4vw, 48px); align-items: center; }

  /* Mockup navegador inclinado, con glow de color por proyecto */
  .work__media { display: block; }
  .mock { border-radius: 16px; overflow: hidden; border: 1px solid var(--line); background: #fff; transition: transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease); transform: rotate(-1.4deg); }
  .work__item--rose .mock { box-shadow: 0 36px 70px -34px rgba(176,20,95,0.5); }
  .work__item--peri .mock { box-shadow: 0 36px 70px -34px rgba(156,22,85,0.5); }
  .work__item--plum .mock { box-shadow: 0 36px 70px -34px rgba(26,16,25,0.6); }
  .work__media:hover .mock { transform: rotate(0deg) translateY(-6px); }
  .mock__bar { display: flex; align-items: center; gap: 6px; padding: 11px 14px; background: var(--bg-2); border-bottom: 1px solid var(--line); }
  .mock__bar i { width: 9px; height: 9px; border-radius: 50%; background: #e0dccf; }
  .mock__url { margin-left: 12px; font-family: var(--font-body); font-size: 0.8rem; color: var(--ink-mute); }
  .mock__body { aspect-ratio: 16 / 10; overflow: hidden; }
  .mock__body img { width: 100%; height: 100%; object-fit: cover; transition: transform var(--dur) var(--ease); }
  .work__media:hover .mock__body img { transform: scale(1.05); }

  .work__sector { font-family: var(--font-body); font-weight: 600; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--ink-mute); }
  .work__name { font-family: var(--font-display); font-weight: 800; font-size: clamp(1.8rem, 3.4vw, 2.8rem); line-height: 1.0; margin: 10px 0 14px; }
  .work__item--rose .work__name { color: var(--t-warm-ink); }
  .work__item--peri .work__name { color: var(--t-stone-ink); }
  .work__item--plum .work__name { color: var(--accent-ink); }
  .work__value { font-size: var(--fs-lead); color: var(--ink-soft); line-height: 1.4; max-width: 42ch; }
  .work__foot { display: flex; align-items: center; gap: 18px; margin-top: var(--s-4); flex-wrap: wrap; }
  .work__status { font-family: var(--font-body); font-weight: 600; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.08em; }
  .work__status--rose { color: var(--t-warm-ink); }
  .work__status--peri { color: var(--t-stone-ink); }
  .work__status--plum { color: var(--accent-ink); }
  .work__cta { font-family: var(--font-display); font-weight: 700; font-size: 0.92rem; color: var(--ink); transition: transform var(--dur) var(--ease); }
  .work__cta:hover { transform: translateX(4px); }

  @media (min-width: 860px) {
    .work__item { grid-template-columns: 1.05fr 0.95fr; gap: clamp(40px, 6vw, 80px); }
    .work__item:nth-child(even) .work__media { order: 2; }
    .work__item:nth-child(even) .mock { transform: rotate(1.4deg); }
    .work__item:nth-child(even) .work__media:hover .mock { transform: rotate(0deg) translateY(-6px); }
  }
  @media (prefers-reduced-motion: reduce) { .mock { transform: none !important; } }
</style>
