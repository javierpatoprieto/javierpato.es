---
// Trabajo · casos con hover (zoom + overlay "Ver el caso") y botón a más
// proyectos. En modo `carousel` (la home) es un carril con scroll-snap y
// flechas, para que quepan todos sin dejar ninguno fuera; en modo normal
// (/proyectos) sigue siendo una rejilla.
const { limit = 99, cols = 4, carousel = false } = Astro.props;
const all = [
  { title: 'CantabriaMásCerca', slug: 'cantabriamascerca', url: 'cantabriamascerca.com', sector: 'Servicios a domicilio · Besaya', value: 'Un negocio nuevo, contado claro y listo para Google.', status: 'Live', tone: 'rose', img: '/img/proj-cantabriamascerca-sm.webp' },
  { title: 'Explora Siam', slug: 'explora-siam', url: 'explorasiam.com', sector: 'Viajes en grupo · Tailandia', value: 'Un viaje contado en una página que acaba en WhatsApp.', status: 'Live', tone: 'peri', img: '/img/proj-explora-sm.webp' },
  { title: 'ArtiMindArt', slug: 'artimindart', url: 'artimind.art', sector: 'Estudio creativo con IA', value: 'Imágenes y vídeo de moda que venden, sin photoshoot.', status: 'Live', tone: 'rose', img: '/img/proj-artimind-sm.webp' },
  { title: 'Fisio Mamá', slug: 'fisio-mama', url: 'fisiomama.es', sector: 'Fisioterapia', value: 'Cita online en un par de clics.', status: 'Live', tone: 'peri', img: '/img/proj-andrea-sm.webp' },
  { title: 'Centro Infantil Periquete', slug: 'centro-infantil-periquete', url: 'centroinfantilperiquete.es', sector: 'Educación infantil', value: 'Reservar plaza sin llamadas ni líos.', status: 'Live', tone: 'rose', img: '/img/proj-periquete-sm.webp' },
  { title: 'Click & Cargo', slug: 'click-and-cargo', url: 'clickandcargo.com', sector: 'Logística y transporte', value: 'Técnica, rápida y directa al grano.', status: 'Live', tone: 'plum', img: '/img/proj-cargo-sm.webp' },
];
const items = all.slice(0, limit);
---
<section id="trabajo" class="section work">
  <div class="wrap">
    <header class="work__head" data-reveal>
      <div class="work__headtxt">
        <span class="work__eyebrow">2026 · Trabajo reciente</span>
        <h2 class="work__title">El trabajo habla solo.</h2>
      </div>
      {carousel && (
        <div class="work__nav" data-work-nav hidden>
          <button type="button" class="work__arrow" data-work-prev aria-label="Proyecto anterior" aria-controls="work-track">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <button type="button" class="work__arrow" data-work-next aria-label="Proyecto siguiente" aria-controls="work-track">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </div>
      )}
    </header>

    <div class={carousel ? 'work__grid work__grid--carousel' : 'work__grid'} id={carousel ? 'work-track' : undefined} data-work-track={carousel ? '' : undefined} data-stagger style={`--work-cols:${cols}`}>
      {items.map((p) => (
        <a class={`work__card work__card--${p.tone}`} href={`/proyectos/${p.slug}`} data-reveal>
          <div class="work__cover">
            <img src={p.img} alt={`${p.title} — diseño web en Cantabria`} loading="lazy" width="1600" height="1096" />
            <span class="work__status">● {p.status}</span>
            <span class="work__overlay"><span class="work__see">Ver el caso →</span></span>
          </div>
          <div class="work__body">
            <span class="work__sector">{p.sector}</span>
            <h3 class="work__name">{p.title}</h3>
            <p class="work__value">{p.value}</p>
          </div>
        </a>
      ))}
    </div>

    <div class="work__more" data-reveal>
      <a href="/proyectos" class="btn btn--green">Ver más proyectos →</a>
    </div>
  </div>
</section>

<style>
  .work { background: var(--t-warm); }
  .work__head { margin-bottom: var(--s-6); display: flex; align-items: flex-end; justify-content: space-between; gap: var(--s-4); }
  .work__headtxt { max-width: 60ch; }

  .work__nav { display: none; gap: 10px; flex: 0 0 auto; padding-bottom: 4px; }
  .work__arrow { display: grid; place-items: center; width: 46px; height: 46px; border-radius: 50%; border: 1px solid var(--line); background: var(--bg-2); color: var(--ink); cursor: pointer; transition: background var(--dur) var(--ease), border-color var(--dur) var(--ease), opacity var(--dur) var(--ease); }
  .work__arrow svg { width: 20px; height: 20px; }
  .work__arrow:hover:not(:disabled) { background: var(--accent); border-color: var(--accent); color: #fff; }
  .work__arrow:disabled { opacity: 0.32; cursor: default; }
  .work__eyebrow { font-family: var(--font-body); font-weight: 600; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.12em; color: var(--accent-ink); }
  .work__title { font-size: var(--fs-h2); color: var(--ink); font-weight: 800; line-height: 1.0; margin-top: 12px; }

  .work__grid { display: grid; grid-template-columns: 1fr; gap: clamp(20px, 2.4vw, 28px); }

  /* Carril horizontal con snap. El padding vertical deja sitio al
     levantamiento y la sombra del hover, que si no quedarían recortados. */
  .work__grid--carousel {
    display: flex;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    padding: 10px 0 28px;
    margin: -10px 0 -28px;
  }
  .work__grid--carousel::-webkit-scrollbar { display: none; }
  .work__grid--carousel .work__card { flex: 0 0 84%; scroll-snap-align: start; }
  @media (prefers-reduced-motion: reduce) { .work__grid--carousel { scroll-behavior: auto; } }

  .work__card { display: flex; flex-direction: column; background: var(--bg-2); border: 1px solid var(--line); border-radius: var(--radius-lg); overflow: hidden; transition: transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease); }
  .work__card:hover { transform: translateY(-6px); }
  .work__card--rose:hover { box-shadow: 0 30px 55px -28px rgba(176,20,95,0.5); }
  .work__card--peri:hover { box-shadow: 0 30px 55px -28px rgba(156,22,85,0.5); }
  .work__card--plum:hover { box-shadow: 0 30px 55px -28px rgba(26,16,25,0.55); }

  .work__cover { position: relative; aspect-ratio: 3 / 2; overflow: hidden; }
  .work__cover img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s var(--ease); }
  .work__card:hover .work__cover img { transform: scale(1.07); }

  .work__status { position: absolute; top: 12px; left: 12px; z-index: 2; display: inline-flex; align-items: center; gap: 5px; background: #fff; color: var(--accent-ink); font-family: var(--font-body); font-weight: 600; font-size: 0.66rem; text-transform: uppercase; letter-spacing: 0.05em; padding: 5px 11px; border-radius: var(--radius-pill); box-shadow: 0 8px 18px -8px rgba(0,0,0,0.35); }

  .work__overlay { position: absolute; inset: 0; display: grid; place-items: center; opacity: 0; transition: opacity 0.35s var(--ease-soft); }
  .work__card--rose .work__overlay { background: color-mix(in srgb, var(--accent) 78%, transparent); }
  .work__card--peri .work__overlay { background: color-mix(in srgb, var(--t-stone-ink) 80%, transparent); }
  .work__card--plum .work__overlay { background: color-mix(in srgb, var(--panel) 80%, transparent); }
  .work__card:hover .work__overlay { opacity: 1; }
  .work__see { font-family: var(--font-display); font-weight: 700; font-size: 0.95rem; color: #fff; border: 2px solid rgba(255,255,255,0.85); padding: 11px 20px; border-radius: var(--radius-pill); transform: translateY(10px); transition: transform 0.35s var(--ease); }
  .work__card:hover .work__see { transform: translateY(0); }

  .work__body { padding: clamp(18px, 2vw, 24px); }
  .work__sector { font-family: var(--font-body); font-weight: 600; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--ink-mute); }
  .work__name { font-family: var(--font-display); font-weight: 800; font-size: 1.4rem; line-height: 1.05; margin: 8px 0 6px; }
  .work__card--rose .work__name { color: var(--t-warm-ink); }
  .work__card--peri .work__name { color: var(--t-stone-ink); }
  .work__card--plum .work__name { color: var(--accent-ink); }
  .work__value { color: var(--ink-soft); font-size: 0.95rem; line-height: 1.4; }

  .work__more { text-align: center; margin-top: clamp(32px, 5vw, 56px); }

  @media (min-width: 600px) {
    .work__grid { grid-template-columns: repeat(2, 1fr); }
    .work__grid--carousel .work__card { flex-basis: calc((100% - clamp(20px, 2.4vw, 28px)) / 2); }
    .work__nav { display: flex; }
  }
  @media (min-width: 1024px) {
    .work__grid { grid-template-columns: repeat(var(--work-cols, 4), 1fr); }
    .work__grid--carousel .work__card { flex-basis: calc((100% - 2 * clamp(20px, 2.4vw, 28px)) / 3); }
  }
</style>

<script>
  const track = document.querySelector<HTMLElement>('[data-work-track]');
  const nav = document.querySelector<HTMLElement>('[data-work-nav]');
  const prev = document.querySelector<HTMLButtonElement>('[data-work-prev]');
  const next = document.querySelector<HTMLButtonElement>('[data-work-next]');

  if (track && nav && prev && next) {
    // Las flechas solo aparecen si de verdad hay algo que desplazar.
    const desbordado = () => track.scrollWidth - track.clientWidth > 8;
    const paso = () => {
      const card = track.querySelector<HTMLElement>('.work__card');
      if (!card) return track.clientWidth;
      const gap = parseFloat(getComputedStyle(track).columnGap || '24') || 24;
      return card.offsetWidth + gap;
    };
    const sincronizar = () => {
      nav.hidden = !desbordado();
      const max = track.scrollWidth - track.clientWidth;
      prev.disabled = track.scrollLeft <= 2;
      next.disabled = track.scrollLeft >= max - 2;
    };

    prev.addEventListener('click', () => track.scrollBy({ left: -paso() }));
    next.addEventListener('click', () => track.scrollBy({ left: paso() }));
    track.addEventListener('scroll', sincronizar, { passive: true });
    addEventListener('resize', sincronizar);
    sincronizar();
  }
</script>
