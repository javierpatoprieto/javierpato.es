---
const includes = ['Web de una página, a medida', 'Móvil, velocidad y Google', 'Sistema visual propio', 'Entrega en 3 días'];
---
<section id="oferta" class="section offer">
  <div class="wrap">
  <div class="offer__card" data-reveal>
    <span class="offer__badge">Plazas limitadas · 2026</span>
    <div class="offer__top">
      <h2 class="offer__title">Web de estudio,<br />sin precio de estudio.</h2>
      <p class="offer__price"><span class="offer__from">desde</span><span class="offer__num">299€</span></p>
    </div>
    <ul class="offer__inc">
      {includes.map((i) => <li>{i}</li>)}
    </ul>
    <a href="#contacto" class="btn offer__cta">Reservar mi plaza →</a>
  </div>
  </div>
</section>

<style>
  .offer__card { position: relative; background: var(--panel); color: var(--panel-ink); border-radius: var(--radius-lg); padding: clamp(28px, 5vw, 64px); }
  .offer__badge { position: absolute; top: clamp(18px,3vw,30px); right: clamp(24px,4vw,44px); background: var(--yellow); color: var(--yellow-ink); font-family: var(--font-display); font-weight: 700; font-size: 0.85rem; padding: 6px 14px; border-radius: var(--radius-pill); transform: rotate(3deg); }
  .offer__top { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 20px; margin-bottom: var(--s-5); }
  .offer__title { font-family: var(--font-display); font-weight: 800; font-size: var(--fs-h2); color: #fff; }
  .offer__price { display: flex; align-items: baseline; gap: 10px; }
  .offer__from { font-family: var(--font-display); font-weight: 600; opacity: 0.7; }
  .offer__num { font-family: var(--font-display); font-weight: 900; font-size: clamp(3.4rem, 10vw, 7rem); letter-spacing: -0.04em; color: var(--accent); line-height: 0.85; }
  .offer__inc { list-style: none; display: grid; gap: 0; margin-bottom: var(--s-5); }
  .offer__inc li { padding: 13px 0; border-top: 1px solid rgba(255,255,255,0.18); font-size: 1.05rem; }
  .offer__cta { background: var(--yellow); color: var(--yellow-ink); }
  .offer__cta:hover { background: #fff; }
  @media (min-width: 760px) { .offer__inc { grid-template-columns: 1fr 1fr; column-gap: 48px; } }
</style>
