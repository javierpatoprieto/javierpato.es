---
const { path = Astro.url.pathname } = Astro.props;
const links = [
  { href: '/', label: 'Inicio' },
  { href: '/diseno-web-cantabria', label: 'Diseño web' },
  { href: '/precios', label: 'Precios' },
  { href: '/proyectos', label: 'Proyectos' },
  { href: '/blog', label: 'Blog' },
  { href: '/estudio', label: 'Estudio' },
];
const active = (h: string) => h === '/' ? path === '/' : path.startsWith(h);
---
<header class="nav" data-nav>
  <div class="wrap nav__inner">
    <a href="/" class="nav__brand">
      <span class="nav__avatar" aria-hidden="true">
        <svg viewBox="0 0 100 100" width="26" height="26">
          <circle cx="37" cy="30" r="5.5" fill="#fff"/>
          <g fill="none" stroke="#fff" stroke-width="8.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M37 44 V63 q0 13 -13 13"/><path d="M63 44 V80"/><path d="M63 45 H72 a13 13 0 0 1 0 26 H63"/>
          </g>
        </svg>
      </span>
      <span class="nav__name">Javier Pato</span>
    </a>

    <nav class="nav__pill" aria-label="Principal">
      {links.map((l) => <a href={l.href} class={`nav__link ${active(l.href) ? 'is-active' : ''}`} aria-current={active(l.href) ? 'page' : undefined}>{l.label}</a>)}
    </nav>

    <div class="nav__actions">
      <button class="nav__icon" data-theme-toggle aria-label="Cambiar tema claro/oscuro"><span class="nav__toggle" aria-hidden="true"></span></button>
      <a href="/contacto" class="nav__btn">Saluda</a>
      <button class="nav__burger" data-burger aria-label="Abrir menú" aria-expanded="false"><span></span><span></span></button>
    </div>
  </div>

  <nav class="nav__mobile" data-mobile aria-label="Menú móvil">
    {links.map((l) => <a href={l.href} class={`nav__mlink ${active(l.href) ? 'is-active' : ''}`}>{l.label}</a>)}
    <a href="/contacto" class="btn btn--green nav__mcta">Saluda →</a>
  </nav>
</header>

<script is:inline>
  (function () {
    var nav = document.querySelector('[data-nav]');
    var burger = document.querySelector('[data-burger]');
    if (!nav || !burger) return;
    function close() { nav.classList.remove('is-open'); burger.setAttribute('aria-expanded', 'false'); }
    burger.addEventListener('click', function () {
      var open = nav.classList.toggle('is-open');
      burger.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
    nav.querySelectorAll('[data-mobile] a').forEach(function (a) { a.addEventListener('click', close); });
  })();
</script>

<style>
  .nav { position: sticky; top: 0; z-index: 60; padding-block: clamp(12px, 2vw, 22px); transition: background var(--dur) var(--ease-soft), padding var(--dur) var(--ease-soft), box-shadow var(--dur) var(--ease-soft); }
  .nav.is-stuck, .nav.is-open { background: color-mix(in srgb, var(--bg) 92%, transparent); backdrop-filter: saturate(1.2) blur(14px); padding-block: 10px; box-shadow: 0 1px 0 var(--line), 0 10px 30px -22px rgba(0,0,0,0.5); }
  .nav__inner { display: flex; align-items: center; justify-content: space-between; gap: 16px; }
  .nav__brand { display: inline-flex; align-items: center; gap: 12px; }
  .nav__avatar { width: 44px; height: 44px; border-radius: 50%; background: var(--accent); color: #fff; display: grid; place-items: center; }
  .nav__name { font-family: var(--font-display); font-weight: 700; font-size: 1.25rem; letter-spacing: -0.02em; }

  .nav__pill { display: flex; align-items: center; gap: 4px; background: color-mix(in srgb, var(--card) 78%, transparent); backdrop-filter: blur(10px); border: 1px solid var(--line); padding: 6px; border-radius: var(--radius-pill); box-shadow: 0 6px 24px -14px rgba(0,0,0,0.4); }
  .nav__link { font-family: var(--font-display); font-weight: 600; font-size: 0.95rem; padding: 9px 16px; border-radius: var(--radius-pill); color: var(--ink); transition: background var(--dur) var(--ease-soft), color var(--dur) var(--ease-soft); }
  .nav__link:hover { color: var(--accent-ink); }
  .nav__link.is-active { background: var(--accent); color: #fff; }

  .nav__actions { display: flex; gap: 8px; align-items: center; }
  .nav__icon { width: 46px; height: 46px; border-radius: 14px; background: var(--bg-2); border: 1px solid var(--line); display: grid; place-items: center; transition: transform var(--dur) var(--ease); }
  .nav__icon:hover { transform: translateY(-2px); }
  .nav__toggle { width: 18px; height: 18px; border-radius: 50%; border: 2px solid var(--ink); background: linear-gradient(90deg, var(--ink) 50%, transparent 50%); transition: transform var(--dur) var(--ease); }
  [data-theme="dark"] .nav__toggle { transform: rotate(180deg); }
  .nav__btn { display: inline-flex; align-items: center; background: var(--btn-bg); color: var(--btn-fg); font-family: var(--font-display); font-weight: 600; font-size: 0.95rem; padding: 12px 18px; border-radius: 14px; transition: transform var(--dur) var(--ease); }
  .nav__btn:hover { transform: translateY(-2px); }

  /* Hamburguesa */
  .nav__burger { display: none; width: 46px; height: 46px; border-radius: 14px; background: var(--bg-2); border: 1px solid var(--line); flex-direction: column; align-items: center; justify-content: center; gap: 5px; }
  .nav__burger span { width: 18px; height: 2px; background: var(--ink); border-radius: 2px; transition: transform var(--dur) var(--ease), opacity var(--dur) var(--ease); }
  .nav.is-open .nav__burger span:first-child { transform: translateY(3.5px) rotate(45deg); }
  .nav.is-open .nav__burger span:last-child { transform: translateY(-3.5px) rotate(-45deg); }

  /* Menú móvil */
  .nav__mobile { display: none; flex-direction: column; gap: 4px; padding: 8px var(--gutter) 20px; }
  .nav__mlink { font-family: var(--font-display); font-weight: 700; font-size: 1.25rem; padding: 12px 4px; color: var(--ink); border-bottom: 1px solid var(--line); }
  .nav__mlink.is-active { color: var(--accent-ink); }
  .nav__mcta { margin-top: 14px; justify-content: center; }

  @media (max-width: 900px) {
    .nav__pill { display: none; }
    .nav__burger { display: flex; }
    .nav.is-open .nav__mobile { display: flex; }
  }
  @media (max-width: 480px) { .nav__name { display: none; } }
</style>
