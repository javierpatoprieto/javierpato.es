---
import Layout from '../layouts/Layout.astro';
interface Props { title: string; description: string; updated: string; }
const { title, description, updated } = Astro.props;
---
<Layout title={`${title} | Javier Pato`} description={description}>
  <article class="section legal">
    <div class="wrap legal__wrap">
      <nav class="legal__bc" aria-label="Migas"><a href="/">Inicio</a> <span aria-hidden="true">/</span> <span>Legal</span></nav>
      <h1 class="legal__h1">{title}</h1>
      <p class="legal__upd">Última actualización: {updated}</p>
      <div class="legal__body"><slot /></div>
    </div>
  </article>

  <style>
    .legal__wrap { max-width: 760px; }
    .legal__bc { font-family: var(--font-mono); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--ink-mute); margin-bottom: var(--s-4); }
    .legal__bc a { color: var(--accent-ink); }
    .legal__h1 { font-size: clamp(2.2rem, 5vw, 3.4rem); font-weight: 700; line-height: 1.0; }
    .legal__upd { font-family: var(--font-mono); font-size: 0.8rem; color: var(--ink-mute); margin: var(--s-3) 0 var(--s-6); }
    .legal__body { font-size: 1.0625rem; line-height: 1.7; color: var(--ink); }
    .legal__body :global(h2) { font-family: var(--font-display); font-weight: 700; font-size: clamp(1.4rem,2.6vw,1.8rem); margin: var(--s-6) 0 var(--s-3); }
    .legal__body :global(h3) { font-family: var(--font-display); font-weight: 700; font-size: 1.2rem; margin: var(--s-5) 0 var(--s-2); }
    .legal__body :global(p) { margin-bottom: var(--s-4); }
    .legal__body :global(ul) { margin: 0 0 var(--s-4) 1.2em; display: grid; gap: 8px; }
    .legal__body :global(strong) { color: var(--ink); font-weight: 700; }
    .legal__body :global(a) { color: var(--accent-ink); font-weight: 600; border-bottom: 1px solid currentColor; }
    .legal__body :global(.fill) { background: color-mix(in srgb, var(--accent) 16%, transparent); color: var(--accent-ink); padding: 0 6px; border-radius: 4px; font-weight: 700; }
    .legal__body :global(table) { width: 100%; border-collapse: collapse; margin-bottom: var(--s-4); font-size: 0.95rem; }
    .legal__body :global(th), .legal__body :global(td) { text-align: left; padding: 10px 12px; border-bottom: 1px solid var(--line); vertical-align: top; }
    .legal__body :global(th) { font-family: var(--font-display); font-weight: 700; }
  </style>
</Layout>
