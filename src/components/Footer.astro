---
const year = 2026;
const cols = [
  { h: 'Servicios', links: [['Diseño web Cantabria', '/diseno-web-cantabria'], ['Logotipo y marca', '/branding-cantabria'], ['Diseño gráfico', '/diseno-grafico-cantabria'], ['Tienda online', '/tienda-online-cantabria'], ['Precios', '/precios']] },
  { h: 'Diseño web', links: [['En Santander', '/diseno-web-santander'], ['En Torrelavega', '/diseno-web-torrelavega'], ['Para clínicas', '/diseno-web-clinicas-cantabria'], ['Para hostelería', '/diseno-web-hosteleria-cantabria'], ['Para autónomos', '/diseno-web-autonomos-cantabria']] },
  { h: 'Estudio', links: [['Proyectos', '/proyectos'], ['Blog', '/blog'], ['Quién soy', '/estudio'], ['Contacto', '/contacto']] },
  { h: 'Encuéntrame', links: [['669 385 624', 'tel:+34669385624'], ['javier@javierpato.es', 'mailto:javier@javierpato.es'], ['WhatsApp', 'https://wa.me/34669385624'], ['X · ArtiMindArt', 'https://x.com/ArtiMindArt']] },
];
---
<footer class="footer">
  <div class="wrap footer__inner">
    <div class="footer__brand">
      <span class="footer__logo">Javier Pato<span class="footer__dot" aria-hidden="true"></span></span>
      <p class="footer__claim">Diseño web y marca para negocios de Cantabria que quieren parecer lo que valen.</p>
      <p class="footer__nap">
        Santander, Cantabria (España)<br />
        <a href="tel:+34669385624" data-loc="footer">669 385 624</a> · Lunes a viernes, 9:00–19:00
      </p>
      <p class="footer__meta" data-clock>Santander</p>
    </div>
    {cols.map((c) => (
      <nav class="footer__col" aria-label={c.h}>
        <p class="footer__h">{c.h}</p>
        {c.links.map(([l, h]) => <a href={h} class="footer__link">{l}</a>)}
      </nav>
    ))}
  </div>
  <div class="wrap footer__base">
    <span>© {year} Javier Pato · Cantabria, España</span>
    <nav class="footer__legal" aria-label="Legal">
      <a href="/aviso-legal">Aviso legal</a>
      <a href="/privacidad">Privacidad</a>
      <a href="/cookies">Cookies</a>
    </nav>
  </div>
</footer>

<style>
  .footer { background: #ab1259; color: #fff; margin-top: var(--s-7); padding-top: var(--s-6); }
  .footer__inner { display: grid; grid-template-columns: 1fr; gap: var(--s-5); padding-bottom: var(--s-5); }
  .footer__logo { font-family: var(--font-display); font-weight: 800; font-size: 1.4rem; display: inline-flex; align-items: center; color: #fff; }
  .footer__dot { width: 7px; height: 7px; border-radius: 50%; background: #fff; margin-left: 4px; }
  .footer__claim { color: rgba(255,255,255,0.95); max-width: 36ch; margin: 12px 0; }
  .footer__meta { font-size: 0.82rem; color: rgba(255,255,255,0.88); }
  .footer__nap { font-size: 0.88rem; color: rgba(255,255,255,0.88); line-height: 1.6; margin: 0 0 10px; }
  .footer__nap a { color: #fff; border-bottom: 1px solid rgba(255,255,255,0.45); }
  .footer__nap a:hover { border-bottom-color: #fff; }
  .footer__h { font-family: var(--font-display); font-weight: 700; margin-bottom: 12px; color: #fff; }
  .footer__legal { display: flex; flex-wrap: wrap; gap: 8px 20px; }
  .footer__legal a { color: rgba(255,255,255,0.9); transition: color var(--dur) var(--ease-soft); }
  .footer__legal a:hover { color: #fff; }
  .footer__col { display: flex; flex-direction: column; gap: 8px; }
  .footer__link { color: rgba(255,255,255,0.92); transition: color var(--dur) var(--ease-soft); width: fit-content; }
  .footer__link:hover { color: #fff; }
  .footer__base { display: flex; flex-wrap: wrap; gap: 10px 24px; justify-content: space-between; padding-block: var(--s-4); border-top: 1px solid rgba(255,255,255,0.3); font-size: 0.82rem; color: rgba(255,255,255,0.9); }
  @media (min-width: 760px) { .footer__inner { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1060px) { .footer__inner { grid-template-columns: 1.7fr repeat(4, 1fr); } }
</style>
