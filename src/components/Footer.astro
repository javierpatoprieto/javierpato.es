---
const year = 2026;
const cols = [
  { h: 'Navega', links: [['Inicio', '/'], ['Diseño web Cantabria', '/diseno-web-cantabria'], ['Precios', '/precios'], ['Proyectos', '/proyectos'], ['Blog', '/blog'], ['Estudio', '/estudio'], ['Contacto', '/contacto']] },
  { h: 'Encuéntrame', links: [['Email', 'mailto:javier@javierpato.es'], ['WhatsApp', 'https://wa.me/34669385624'], ['X · ArtiMindArt', 'https://x.com/ArtiMindArt'], ['LinkedIn', 'https://www.linkedin.com/']] },
];
---
<footer class="footer">
  <div class="wrap footer__inner">
    <div class="footer__brand">
      <span class="footer__logo">Javier Pato<span class="footer__dot" aria-hidden="true"></span></span>
      <p class="footer__claim">Diseño web y marca para negocios de Cantabria que quieren parecer lo que valen.</p>
      <p class="footer__meta" data-clock>Santander</p>
    </div>
    {cols.map((c) => (
      <nav class="footer__col" aria-label={c.h}>
        <p class="footer__h">{c.h}</p>
        {c.links.map(([l, h]) => <a href={h} class="footer__link">{l}</a>)}
      </nav>
    ))}
  </div>
  <div class="wrap footer__base">
    <span>© {year} Javier Pato · Cantabria, España</span>
    <nav class="footer__legal" aria-label="Legal">
      <a href="/aviso-legal">Aviso legal</a>
      <a href="/privacidad">Privacidad</a>
      <a href="/cookies">Cookies</a>
    </nav>
  </div>
</footer>

<style>
  .footer { border-top: 1px solid var(--line); margin-top: var(--s-7); padding-top: var(--s-6); }
  .footer__inner { display: grid; grid-template-columns: 1fr; gap: var(--s-5); padding-bottom: var(--s-5); }
  .footer__logo { font-family: var(--font-display); font-weight: 800; font-size: 1.4rem; display: inline-flex; align-items: center; }
  .footer__dot { width: 7px; height: 7px; border-radius: 50%; background: var(--accent); margin-left: 4px; }
  .footer__claim { color: var(--ink-soft); max-width: 36ch; margin: 12px 0; }
  .footer__meta { font-size: 0.82rem; color: var(--ink-mute); }
  .footer__h { font-family: var(--font-display); font-weight: 700; margin-bottom: 12px; }
  .footer__legal { display: flex; flex-wrap: wrap; gap: 8px 20px; }
  .footer__legal a { color: var(--ink-mute); transition: color var(--dur) var(--ease-soft); }
  .footer__legal a:hover { color: var(--accent-ink); }
  .footer__col { display: flex; flex-direction: column; gap: 8px; }
  .footer__link { color: var(--ink-soft); transition: color var(--dur) var(--ease-soft); width: fit-content; }
  .footer__link:hover { color: var(--accent-ink); }
  .footer__base { display: flex; flex-wrap: wrap; gap: 10px 24px; justify-content: space-between; padding-block: var(--s-4); border-top: 1px solid var(--line); font-size: 0.82rem; color: var(--ink-mute); }
  @media (min-width: 760px) { .footer__inner { grid-template-columns: 2fr 1fr 1fr; } }
</style>
