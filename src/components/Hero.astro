---
// Hero · copy canalla + cluster de tarjetas en abanico (chispa benshih). Keyword: diseño web Cantabria.
const cards = [
  { type: 'text', cls: 'warm', title: 'Marca + Web', body: 'Diseño que vende.', cta: 'Ver servicios', href: '/diseno-web-cantabria', r: '-7deg', sticker: '✦' },
  { type: 'media', cls: 'media', img: '/img/javier-sm.webp', cta: 'Soy yo', href: '/estudio', r: '3deg', sticker: '👋' },
  { type: 'text', cls: 'stone', title: 'ArtiMindArt', body: 'IA con criterio.', cta: 'Conócelo', href: '/estudio', r: '-2deg', sticker: '✺' },
  { type: 'text', cls: 'deep', title: 'Desde 299€', body: 'Tu web, ya.', cta: 'La quiero', href: '/contacto', r: '6deg', sticker: '🔥' },
];
---
<section class="hero">
  <div class="wrap">
    <div class="hero__panel panel">
      <span class="hero__badge" data-reveal>Diseño web · Cantabria 2026</span>
      <h1 class="hero__title" data-reveal>
        Webs que venden,<br />no que <span class="hero__accent">decoran.</span>
      </h1>
      <p class="hero__lead" data-reveal>
        Soy Javier Pato, diseñador de marca y web en <span class="chip"><span class="chip__d" aria-hidden="true"></span>Cantabria</span>.
        Hago webs a medida que cargan rápido, salen en Google y hacen que tu negocio parezca lo que vale —no una
        plantilla más. <strong>Branding, diseño web y tienda online</strong> para negocios de Santander, Torrelavega y
        toda la región, con criterio de estudio y sin precio de agencia. Tu competencia sigue con una web de 2012:
        <strong>aprovéchalo.</strong>
      </p>
      <div class="hero__fan" data-reveal>
        {cards.map((c) => (
          <a href={c.href} class={`hcard hcard--${c.cls}`} style={`--r:${c.r}`}>
            {c.type === 'media' ? (
              <>
                <img class="hcard__img" src={c.img} alt="" loading="lazy" />
                <span class="hcard__btn hcard__btn--float">{c.cta}</span>
              </>
            ) : (
              <>
                <h2 class="hcard__title">{c.title}</h2>
                <p class="hcard__body">{c.body}</p>
                <span class="hcard__btn">{c.cta}</span>
              </>
            )}
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .hero { padding-top: clamp(10px, 1.6vw, 18px); padding-bottom: clamp(40px, 6vw, 88px); }
  .hero__panel { position: relative; display: flex; flex-direction: column; min-height: calc(100svh - clamp(92px, 12vh, 124px)); padding: clamp(28px, 4.5vw, 64px) clamp(24px, 5vw, 68px) clamp(24px, 3vw, 40px); }
  .hero__badge { display: inline-block; align-self: flex-start; background: var(--yellow); color: var(--yellow-ink); font-family: var(--font-display); font-weight: 700; font-size: 0.9rem; padding: 7px 15px; border-radius: var(--radius-pill); transform: rotate(-2deg); margin-bottom: var(--s-3); }
  @media (min-width: 720px) { .hero__badge { position: absolute; top: clamp(20px,4vw,40px); right: clamp(24px,5vw,56px); margin: 0; transform: rotate(4deg); } }
  .hero__claim { font-family: var(--font-display); font-weight: 600; color: var(--accent-ink); font-size: clamp(1rem, 1.6vw, 1.3rem); max-width: 40ch; margin-bottom: var(--s-3); }
  .hero__title { font-size: var(--fs-hero); font-weight: 800; line-height: 0.96; max-width: 18ch; }
  .hero__accent { color: var(--accent-ink); }
  .hero__lead { font-size: clamp(1.05rem, 1.5vw, 1.35rem); color: var(--ink-soft); max-width: min(94%, 76ch); margin-top: var(--s-4); line-height: 1.45; }
  .hero__lead strong { color: var(--ink); }
  .chip { display: inline-flex; align-items: center; gap: 6px; background: var(--card); border: 1px solid var(--line); padding: 1px 12px; border-radius: var(--radius-pill); font-weight: 600; color: var(--ink); font-size: 0.92em; vertical-align: middle; }
  .chip__d { width: 11px; height: 11px; border-radius: 50%; background: var(--accent); }
  .hero__cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: var(--s-5); }

  .hero__banner { position: relative; margin-top: clamp(18px, 2.4vw, 28px); border-radius: var(--radius-lg); overflow: hidden; }
  .hero__banner img { width: 100%; height: clamp(220px, 38vw, 460px); object-fit: cover; }
  .hero__banner figcaption { position: absolute; left: clamp(18px,3vw,34px); bottom: clamp(16px,3vw,28px); color: #f3eee6; font-family: var(--font-display); font-weight: 700; font-size: clamp(1.1rem,2.4vw,1.8rem); text-shadow: 0 2px 20px rgba(0,0,0,0.5); }

  /* Cluster en abanico (desktop) */
  .hero__fan { display: grid; grid-template-columns: 1fr; gap: clamp(16px,2vw,22px); margin-top: auto; padding-top: clamp(32px,5vw,64px); }
  .hcard { position: relative; display: flex; flex-direction: column; justify-content: flex-start; min-height: clamp(190px, 22vw, 240px); padding: clamp(20px,2.3vw,26px); border-radius: var(--radius); transition: transform var(--dur) var(--ease), box-shadow var(--dur) var(--ease); box-shadow: 0 18px 44px -28px rgba(0,0,0,0.55); }
  .hcard--warm { background: var(--t-warm); color: var(--t-warm-ink); }
  .hcard--stone { background: var(--t-stone); color: var(--t-stone-ink); }
  .hcard--deep { background: var(--t-deep); color: var(--t-deep-ink); }
  .hcard--media { background: var(--card); padding: 0; overflow: visible; }
  .hcard__img { width: 100%; height: 100%; min-height: 220px; object-fit: cover; border-radius: var(--radius); }
  .hcard__title { font-family: var(--font-display); font-weight: 800; font-size: clamp(1.9rem,3.2vw,2.6rem); line-height: 1.0; color: inherit; }
  .hcard__body { color: inherit; margin-top: 8px; font-size: 1.05rem; line-height: 1.3; }
  .hcard--deep .hcard__body { opacity: 0.9; }
  .hcard__btn { align-self: flex-start; margin-top: auto; display: inline-flex; background: var(--btn-bg); color: var(--btn-fg); font-family: var(--font-display); font-weight: 700; font-size: 0.9rem; padding: 10px 18px; border-radius: 12px; transition: transform var(--dur) var(--ease); }
  .hcard--deep .hcard__btn { background: var(--accent); color: #fff; }
  .hcard__btn--float { position: absolute; left: 18px; bottom: 18px; margin: 0; z-index: 2; }
  .hcard:hover .hcard__btn { transform: scale(1.04); }

  @media (min-width: 880px) {
    .hero__panel { padding-bottom: clamp(28px, 3.5vw, 48px); overflow: visible; }
    .hero__fan { display: flex; justify-content: center; align-items: flex-start; gap: 0; margin-top: auto; padding-top: clamp(20px,3vw,40px); position: relative; z-index: 5; }
    .hcard { width: clamp(230px, 23vw, 290px); margin-inline: clamp(-40px, -3vw, -26px); transform: rotate(var(--r)); }
    .hcard:nth-child(1) { z-index: 1; } .hcard:nth-child(2) { z-index: 2; }
    .hcard:nth-child(3) { z-index: 3; } .hcard:nth-child(4) { z-index: 4; }
    .hcard:hover { transform: rotate(0deg) translateY(-18px) scale(1.05); z-index: 10; box-shadow: 0 40px 70px -30px rgba(0,0,0,0.55); }
    .hero__banner { margin-top: clamp(28px, 4vw, 48px); }
  }
  @media (prefers-reduced-motion: reduce) { .hcard { transform: none !important; } }
</style>
