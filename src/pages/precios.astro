---
import Layout from '../layouts/Layout.astro';

const plans = [
  { id: 'onepage', name: 'One-page', price: 299, time: '3 días', desc: 'Una sola página, a medida, que lo cuenta todo de un vistazo y empuja a que te escriban. El arranque perfecto si necesitas presencia ya y sin complicarte.', feats: ['Diseño a medida', 'Móvil + velocidad', 'SEO básico', 'Contacto integrado'], pop: false },
  { id: 'basica', name: 'Básica', price: 549, time: '1 semana', desc: '4 páginas para contar quién eres, qué haces y por qué tú. El equilibrio justo para la mayoría de negocios de Cantabria que quieren algo serio.', feats: ['4 páginas', 'Diseño a medida', 'SEO local', '1 ronda de cambios'], pop: true, why: 'Cuatro páginas es donde la web deja de quedarse corta: inicio, servicios, sobre mí y contacto. Con una sola te aprietas en cuanto tienes más de un servicio que explicar; con seis acabas rellenando dos que no aportan nada. Empieza por aquí y muévete arriba o abajo.' },
  { id: 'pro', name: 'Pro', price: 699, time: '1 semana', desc: '6 páginas para desplegar todo tu negocio con holgura: servicios, proyectos, blog… Cuando quieres contarlo bien y posicionar por más palabras en Google.', feats: ['6 páginas', 'Diseño a medida', 'SEO local', 'Blog opcional'], pop: false },
  { id: 'ecommerce', name: 'Ecommerce', price: 999, from: true, time: '2–3 semanas', desc: 'Tu tienda online lista para cobrar mientras duermes: catálogo, pagos y envíos. Vender por internet desde Cantabria sin depender de marketplaces que se llevan tu margen.', feats: ['Catálogo + pagos', 'Diseño a medida', 'SEO local', 'Formación incluida'], pop: false },
];
const addons = [
  { id: 'dominio', name: 'Dominio propio', price: 19.99, unit: '/año', desc: 'Tu .es o .com, gestionado por mí.' },
  { id: 'hosting', name: 'Alojamiento', price: 49, unit: '/año', desc: 'Hosting rápido y seguro, sin que te preocupes.' },
  { id: 'manten', name: 'Mantenimiento', price: 190, unit: '/año', desc: 'Cambios, copias y soporte todo el año.' },
];
// Tabla comparativa: cada fila tiene un valor por plan, en el mismo orden que `plans`.
// true = incluido, false = no va, string = matiz.
const compare = [
  { label: 'Páginas',                    vals: ['1', '4', '6', 'Catálogo + páginas fijas'] },
  { label: 'Entrega',                    vals: ['3 días', '1 semana', '1 semana', '2–3 semanas'] },
  { label: 'Diseño a medida (sin plantilla)', vals: [true, true, true, true] },
  { label: 'Móvil y velocidad',          vals: [true, true, true, true] },
  { label: 'Formulario de contacto',     vals: [true, true, true, true] },
  { label: 'SEO',                        vals: ['Básico', 'Local', 'Local', 'Local'] },
  { label: 'Ronda de cambios incluida',  vals: ['1', '1', '1', '1'] },
  { label: 'Blog o sección de noticias', vals: [false, false, 'Opcional', false] },
  { label: 'Catálogo, pagos y envíos',   vals: [false, false, false, true] },
  { label: 'Formación para gestionarla', vals: [false, false, false, true] },
  { label: 'Precio',                     vals: ['299€', '549€', '699€', 'desde 999€'], strong: true },
];
const noIncluye = [
  { t: 'Escribirte los textos de cero (y reescribirlos cinco veces)', d: 'Te doy la estructura de cada página y afino lo que me pases. Si llegas con el folio en blanco, dímelo en la primera charla: se puede resolver, pero se habla antes de empezar, no a mitad.' },
  { t: 'Campañas de pago', d: 'Google Ads y Meta Ads no van dentro. La web queda lista para recibir ese tráfico y para medirlo, pero ni gestiono la campaña ni pongo el presupuesto de anuncios.' },
  { t: 'Gestión de redes sociales', d: 'No publico por ti ni llevo tu Instagram.' },
  { t: 'Fotografía y vídeo', d: 'Si tienes fotos, las recorto, las optimizo y las coloco. Si no tienes ninguna, hay que resolverlo antes de maquetar: una web bonita con fotos malas sigue siendo una web con fotos malas.' },
  { t: 'Logotipo y marca', d: 'Si llegas sin logo, sin colores y sin tipografías, la web se queda coja. Eso es otro trabajo: <a href="/branding-cantabria" class="tlink">branding en Cantabria</a>.' },
  { t: 'Piezas gráficas', d: 'Dossier, flyers, cartas, rótulos o etiquetas no entran en un plan de web. Van por su lado: <a href="/diseno-grafico-cantabria" class="tlink">diseño gráfico en Cantabria</a>.' },
  { t: 'Dar de alta tus productos uno a uno', d: 'En el plan de ecommerce monto la tienda, dejo el catálogo funcionando y te enseño a usarlo. Meter 300 referencias a mano es otra faena: lo vemos en <a href="/tienda-online-cantabria" class="tlink">tienda online</a>.' },
  { t: 'Contenido nuevo cada mes', d: 'El mantenimiento (190€/año) cubre cambios, copias de seguridad y soporte. No cubre escribirte un artículo al mes ni rehacer secciones enteras.' },
];
const faqs = [
  { q: '¿Cuánto cuesta una página web en Cantabria?', a: 'Desde 299€ la one-page (a medida, entregada en 3 días). La Básica de 4 páginas son 549€, la Pro de 6 páginas 699€ y una tienda online desde 999€. Todos con el IVA incluido. Precios cerrados, sin presupuestos sorpresa.' },
  { q: '¿El precio incluye dominio y alojamiento?', a: 'El diseño y desarrollo van en el precio del plan. El dominio propio (19,99€/año) y el alojamiento (49€/año), también con IVA incluido, son extras opcionales que puedo gestionar yo para que no te preocupes de nada.' },
  { q: '¿Cuánto tardas en entregar la web?', a: 'La one-page en 3 días, la Básica y la Pro en una semana, y la tienda online entre 2 y 3 semanas. Rápido, pero a medida: nada de plantillas.' },
  { q: '¿Hay cuotas mensuales o pagos ocultos?', a: 'No. Pagas la web una vez y es tuya. Lo único recurrente, y solo si lo quieres, son dominio, alojamiento o el mantenimiento anual (190€/año) para cambios, copias y soporte.' },
  { q: '¿Qué pasa si necesito cambios después?', a: 'Cada plan incluye una ronda de cambios. Si más adelante quieres seguir evolucionando la web, el plan de mantenimiento anual cubre ajustes y soporte durante todo el año.' },
];
const offers = [
  ...plans.map((p) => ({
    '@type': 'Offer',
    name: `Web ${p.name}`,
    description: p.desc,
    price: p.price,
    priceCurrency: 'EUR',
    priceSpecification: { '@type': 'PriceSpecification', price: p.price, priceCurrency: 'EUR', valueAddedTaxIncluded: true },
    url: 'https://javierpato.es/contacto',
    availability: 'https://schema.org/InStock',
    areaServed: 'Cantabria',
  })),
  ...addons.map((a) => ({
    '@type': 'Offer',
    name: a.name,
    description: a.desc,
    price: a.price,
    priceCurrency: 'EUR',
    priceSpecification: { '@type': 'PriceSpecification', price: a.price, priceCurrency: 'EUR', valueAddedTaxIncluded: true },
    url: 'https://javierpato.es/contacto',
    availability: 'https://schema.org/InStock',
    areaServed: 'Cantabria',
  })),
];
const jsonld = [
  {
    '@context': 'https://schema.org', '@type': 'Service', serviceType: 'Diseño web',
    name: 'Diseño web en Cantabria',
    areaServed: 'Cantabria',
    provider: { '@type': 'Person', name: 'Javier Pato', url: 'https://javierpato.es' },
    url: 'https://javierpato.es/precios',
    offers,
  },
  {
    '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://javierpato.es' },
      { '@type': 'ListItem', position: 2, name: 'Precios', item: 'https://javierpato.es/precios' },
    ],
  },
];
---
<Layout
  title="Precios de diseño web en Cantabria desde 299€ | Javier Pato"
  description="Precios de diseño web en Cantabria con IVA incluido: one-page 299€, 4 páginas 549€, 6 páginas 699€ y tienda online desde 999€."
  jsonld={jsonld}
>
  <section class="section pr-hero has-aura">
    <div class="wrap">
      <span class="pr-k" data-reveal>Precios · Diseño web Cantabria</span>
      <h1 class="pr-h1" data-reveal>Precios claros.<br /><span class="pr-a">Cero sustos.</span></h1>
      <p class="pr-lead" data-reveal>Aquí no hay "depende" ni presupuestos de 12 páginas. Eliges plan, marcas los extras y ves el total al momento —lo que cuesta tu web en Cantabria, claro y a la cara. Entrega en <strong>una semana o menos</strong> y precio cerrado antes de empezar. <strong>Todos los precios llevan el IVA incluido</strong>: lo que ves es lo que pagas.</p>
      <p class="pr-cross" data-reveal><a href="/diseno-web-cantabria" class="tlink">¿Primero quieres ver cómo trabajo? Mira el servicio de diseño web en Cantabria →</a></p>
    </div>
  </section>

  <section class="section pr-config">
    <div class="wrap pr-grid">
      <div class="pr-main">
        <h2 class="pr-h2" data-reveal>1 · Elige tu web</h2>
        <div class="pr-plans" data-stagger>
          {plans.map((p) => (
            <label class={`pr-plan ${p.pop ? 'is-pop' : ''}`} data-reveal>
              <input type="radio" name="plan" value={p.id} data-price={p.price} data-name={p.name} checked={p.id === 'basica'} />
              <span class="pr-plan__in">
                {p.pop && <span class="pr-badge">El más elegido · empieza por aquí</span>}
                <span class="pr-plan__top">
                  <span class="pr-plan__name">{p.name}</span>
                  <span class="pr-plan__price">{p.from ? 'desde ' : ''}{p.price}€</span>
                </span>
                <span class="pr-plan__time">Entrega en {p.time}</span>
                <span class="pr-plan__desc">{p.desc}</span>
                {p.why && <span class="pr-plan__why">{p.why}</span>}
                <span class="pr-plan__feats">{p.feats.map((f) => <span class="pr-feat">{f}</span>)}</span>
              </span>
            </label>
          ))}
        </div>

        <h2 class="pr-h2 pr-h2--mt" data-reveal>2 · Añade extras</h2>
        <div class="pr-addons" data-stagger>
          {addons.map((a) => (
            <label class="pr-addon" data-reveal>
              <input type="checkbox" data-price={a.price} data-name={a.name} />
              <span class="pr-addon__box" aria-hidden="true">✓</span>
              <span class="pr-addon__txt">
                <span class="pr-addon__top"><span class="pr-addon__name">{a.name}</span><span class="pr-addon__price">+{a.price.toString().replace('.', ',')}€<small>{a.unit}</small></span></span>
                <span class="pr-addon__desc">{a.desc}</span>
              </span>
            </label>
          ))}
        </div>
      </div>

      <aside class="pr-summary" data-reveal>
        <div class="pr-sum-card">
          <span class="pr-sum-k">Tu presupuesto</span>
          <div class="pr-sum-total"><span id="pr-total">549€</span></div>
          <p class="pr-sum-note" id="pr-note">Web Básica · entrega en 1 semana</p>
          <ul class="pr-sum-list" id="pr-list"></ul>
          <a href="/contacto" class="btn btn--green pr-sum-cta" id="pr-cta">Reservar esta web →</a>
          <p class="pr-sum-fine">Precio orientativo, IVA incluido. Lo cerramos en una charla de 20 min, sin compromiso.</p>
        </div>
      </aside>
    </div>
  </section>

  <section class="section pr-cmp-sec">
    <div class="wrap">
      <h2 class="pr-h2 tbar" data-reveal>Qué lleva cada plan, sin letra pequeña</h2>
      <p class="pr-cmp-lead" data-reveal>La diferencia entre planes no es la calidad del diseño —eso no lo bajo por 250€ menos—, es <strong>cuánto sitio tienes para contarte</strong>. Lee la tabla por la columna de la Básica y decide desde ahí: si te sobra sitio, bajas; si se te queda pequeña, subes.</p>
      <div class="pr-table-wrap" data-reveal>
        <table class="pr-table">
          <caption class="pr-table__cap">Comparativa de planes de diseño web en Cantabria</caption>
          <thead>
            <tr>
              <th scope="col" class="pr-table__rowh">&nbsp;</th>
              {plans.map((p) => (
                <th scope="col" class={p.pop ? 'is-pop' : ''}>
                  {p.name}
                  {p.pop && <span class="pr-table__tag">Recomendado</span>}
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {compare.map((row) => (
              <tr class={row.strong ? 'is-strong' : ''}>
                <th scope="row" class="pr-table__rowh">{row.label}</th>
                {row.vals.map((v, i) => (
                  <td class={plans[i].pop ? 'is-pop' : ''}>
                    {v === true && <span class="pr-yes" aria-label="Incluido">✓</span>}
                    {v === false && <span class="pr-no" aria-label="No incluido">—</span>}
                    {typeof v === 'string' && <span>{v}</span>}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="pr-table__foot" data-reveal>Dominio (19,99€/año), alojamiento (49€/año) y mantenimiento (190€/año) son extras opcionales en los cuatro planes. Si lo tuyo es vender online y quieres ver cómo monto una tienda antes de decidir, pásate por <a href="/tienda-online-cantabria" class="tlink">tienda online en Cantabria</a>.</p>
    </div>
  </section>

  <section class="section pr-nope-sec">
    <div class="wrap">
      <h2 class="pr-h2 tbar" data-reveal>Lo que NO va incluido</h2>
      <p class="pr-nope-lead" data-reveal>Prefiero decirlo ahora que discutirlo a mitad del proyecto. Nada de esto entra en el precio de un plan:</p>
      <ul class="pr-nope" data-stagger>
        {noIncluye.map((n) => (
          <li class="pr-nope__item" data-reveal>
            <span class="pr-nope__t">{n.t}</span>
            <span class="pr-nope__d" set:html={n.d} />
          </li>
        ))}
      </ul>
      <p class="pr-nope__end" data-reveal>Tampoco va la web en dos idiomas: duplicar todo en inglés es duplicar páginas y trabajo, así que se habla antes de empezar. Si algo de esto lo necesitas, se dice en la primera charla y se pone en el presupuesto. Lo que no va a pasar es que aparezca en la factura sin avisar. <a href="/contacto" class="tlink">Cuéntame qué necesitas →</a></p>
    </div>
  </section>

  <section class="section pr-faq-sec tone-rose">
    <div class="wrap">
      <h2 class="pr-h2 tbar" data-reveal>Preguntas sobre precios</h2>
      <div class="pr-faq" data-stagger>
        {faqs.map((f) => (
          <details class="pr-q" data-reveal><summary>{f.q}</summary><p>{f.a}</p></details>
        ))}
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      const fmt = (n) => Number.isInteger(n) ? n + '€' : n.toFixed(2).replace('.', ',') + '€';
      const totalEl0 = () => document.getElementById('pr-total');
      function countUp(from, to, isFrom) {
        const el = totalEl0(); const dur = 450; const t0 = performance.now();
        const step = (now) => {
          const k = Math.min(1, (now - t0) / dur);
          const e = 1 - Math.pow(1 - k, 3);
          const val = from + (to - from) * e;
          el.textContent = (isFrom ? 'desde ' : '') + fmt(Math.round(val * 100) / 100);
          if (k < 1) requestAnimationFrame(step);
        };
        requestAnimationFrame(step);
      }
      const planEls = () => document.querySelectorAll('input[name="plan"]');
      const addonEls = () => document.querySelectorAll('.pr-addon input');
      const totalEl = document.getElementById('pr-total');
      const noteEl = document.getElementById('pr-note');
      const listEl = document.getElementById('pr-list');
      const ctaEl = document.getElementById('pr-cta');
      function recalc() {
        let plan = document.querySelector('input[name="plan"]:checked');
        let base = plan ? parseFloat(plan.dataset.price) : 0;
        let pname = plan ? plan.dataset.name : '';
        let from = plan && plan.value === 'ecommerce';
        let extras = 0; let rows = [`<li><span>Web ${pname}</span><span>${fmt(base)}</span></li>`];
        addonEls().forEach((a) => { if (a.checked) { const p = parseFloat(a.dataset.price); extras += p; rows.push(`<li><span>${a.dataset.name}</span><span>+${fmt(p)}/año</span></li>`); } });
        const total = base + extras;
        countUp(parseFloat(totalEl.dataset.v || '0'), total, from);
        totalEl.dataset.v = String(total);
        noteEl.textContent = `Web ${pname}` + (extras ? ` + ${addonEls().length && [...addonEls()].filter(a=>a.checked).length} extra(s)` : '');
        listEl.innerHTML = rows.join('');
        const subject = encodeURIComponent(`Web ${pname} — ${fmt(total)}`);
        ctaEl.href = `/contacto`;
        ctaEl.setAttribute('data-mailto', `mailto:javier@javierpato.es?subject=${subject}`);
      }
      planEls().forEach((e) => e.addEventListener('change', recalc));
      addonEls().forEach((e) => e.addEventListener('change', recalc));
      recalc();
    })();
  </script>

  <style>
    .pr-hero { padding-top: clamp(28px, 4vw, 64px); padding-bottom: var(--s-5); }
    .pr-k { font-family: var(--font-body); font-weight: 600; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.12em; color: var(--accent-ink); }
    .pr-h1 { font-size: clamp(2.6rem, 6vw, 5rem); font-weight: 700; line-height: 0.98; margin: var(--s-3) 0 var(--s-4); }
    .pr-a { color: var(--accent-ink); }
    .pr-lead { font-size: var(--fs-lead); color: var(--ink-soft); max-width: 56ch; line-height: 1.45; }
    .pr-lead strong { color: var(--ink); }
    .pr-cross { margin-top: var(--s-3); font-size: 0.95rem; }

    .pr-grid { display: grid; grid-template-columns: 1fr; gap: clamp(24px,4vw,40px); align-items: start; }
    .pr-h2 { font-family: var(--font-display); font-weight: 700; font-size: clamp(1.4rem,2.4vw,1.9rem); margin-bottom: var(--s-4); }
    .pr-h2--mt { margin-top: var(--s-6); }

    .pr-plans { display: grid; grid-template-columns: 1fr; gap: 14px; }
    .pr-plan { position: relative; cursor: pointer; display: block; }
    .pr-plan input { position: absolute; opacity: 0; }
    .pr-plan__in { display: block; background: var(--bg-2); border: 2px solid var(--line); border-radius: var(--radius); padding: clamp(18px,2.4vw,26px); transition: border-color var(--dur) var(--ease-soft), transform var(--dur) var(--ease); }
    .pr-plan:hover .pr-plan__in { transform: translateY(-3px); }
    .pr-plan input:checked + .pr-plan__in { border-color: var(--accent); background: var(--card); box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 18%, transparent); }
    .pr-plan input:focus-visible + .pr-plan__in { outline: 2px solid var(--accent); outline-offset: 2px; }
    .pr-badge { position: absolute; top: -11px; left: 22px; z-index: 2; background: var(--accent); color: #fff; font-family: var(--font-display); font-weight: 600; font-size: 0.72rem; padding: 3px 12px; border-radius: var(--radius-pill); }

    /* Plan ancla: manda aunque no esté seleccionado */
    .pr-plan.is-pop .pr-plan__in { border-color: var(--accent); background: color-mix(in srgb, var(--accent) 6%, var(--card, var(--bg-2))); box-shadow: 0 22px 45px -30px color-mix(in srgb, var(--accent) 70%, transparent); }
    .pr-plan.is-pop .pr-plan__name { font-size: 1.7rem; }
    .pr-plan.is-pop .pr-plan__price { font-size: 2.1rem; }
    .pr-plan.is-pop input:checked + .pr-plan__in { box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 22%, transparent), 0 22px 45px -30px color-mix(in srgb, var(--accent) 70%, transparent); }
    .pr-plan__why { display: block; color: var(--ink); font-size: 0.92rem; line-height: 1.5; margin: 0 0 12px; padding-left: 12px; border-left: 3px solid var(--accent); }
    .pr-plan__top { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
    .pr-plan__name { font-family: var(--font-display); font-weight: 700; font-size: 1.4rem; }
    .pr-plan__price { font-family: var(--font-display); font-weight: 700; font-size: 1.6rem; color: var(--accent-ink); }
    .pr-plan__time { display: inline-block; margin-top: 6px; font-size: 0.85rem; color: var(--ink-soft); }
    .pr-plan__desc { display: block; color: var(--ink-soft); margin: 10px 0 12px; }
    .pr-plan__feats { display: flex; flex-wrap: wrap; gap: 6px 16px; }
    .pr-feat { font-size: 0.82rem; color: var(--ink-soft); display: inline-flex; align-items: center; }
    .pr-feat::before { content: ''; width: 14px; height: 2px; background: var(--accent); margin-right: 8px; border-radius: 2px; }

    .pr-addons { display: grid; gap: 12px; }
    .pr-addon { cursor: pointer; display: flex; gap: 14px; align-items: flex-start; background: var(--bg-2); border: 1px solid var(--line); border-radius: var(--radius); padding: clamp(16px,2vw,22px); transition: border-color var(--dur) var(--ease-soft); }
    .pr-addon input { position: absolute; opacity: 0; }
    .pr-addon__box { flex: none; width: 26px; height: 26px; border-radius: 8px; border: 2px solid var(--line); display: grid; place-items: center; color: transparent; font-size: 0.85rem; font-weight: 700; transition: all var(--dur) var(--ease-soft); }
    .pr-addon input:checked + .pr-addon__box { background: var(--accent); border-color: var(--accent); color: #fff; }
    .pr-addon:has(input:checked) { border-color: var(--accent); }
    .pr-addon__top { display: flex; justify-content: space-between; gap: 12px; }
    .pr-addon__name { font-family: var(--font-display); font-weight: 700; }
    .pr-addon__price { font-family: var(--font-display); font-weight: 700; color: var(--accent-ink); white-space: nowrap; }
    .pr-addon__price small { color: var(--ink-mute); font-weight: 500; }
    .pr-addon__desc { display: block; color: var(--ink-soft); font-size: 0.9rem; margin-top: 4px; }

    .pr-sum-card { background: var(--panel); color: var(--panel-ink); border-radius: var(--radius-lg); padding: clamp(24px,3vw,36px); position: sticky; top: 90px; }
    .pr-sum-k { font-family: var(--font-body); font-weight: 600; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.1em; opacity: 0.7; }
