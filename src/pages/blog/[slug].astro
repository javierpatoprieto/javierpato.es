---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await post.render();
const d = post.data;
const fmt = (date: Date) => new Intl.DateTimeFormat('es-ES', { day: 'numeric', month: 'long', year: 'numeric' }).format(date);

const postUrl = `https://javierpato.es/blog/${post.slug}/`;
const coverUrl = new URL(d.cover, 'https://javierpato.es').toString();

const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: d.title,
    description: d.description,
    image: coverUrl,
    datePublished: d.pubDate.toISOString(),
    dateModified: (d.updatedDate ?? d.pubDate).toISOString(),
    inLanguage: 'es-ES',
    keywords: d.keyword,
    author: { '@type': 'Person', '@id': 'https://javierpato.es/#javier', name: 'Javier Pato', url: 'https://javierpato.es/estudio/' },
    publisher: { '@type': 'Person', '@id': 'https://javierpato.es/#javier', name: 'Javier Pato' },
    mainEntityOfPage: { '@type': 'WebPage', '@id': postUrl },
    url: postUrl,
  },
  ...(d.faqs.length
    ? [{
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: d.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
      }]
    : []),
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: 'https://javierpato.es' },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://javierpato.es/blog/' },
      { '@type': 'ListItem', position: 3, name: d.title, item: postUrl },
    ],
  },
];
---
<Layout title={`${d.title} | Javier Pato`} description={d.description} ogImage={d.cover} jsonld={jsonld}>
  <article class="section post">
    <div class="wrap post__wrap">
      <nav class="post__bc" aria-label="Migas"><a href="/blog/">Blog</a> <span aria-hidden="true">/</span> <span>{d.tags[0] ?? 'Artículo'}</span></nav>
      <span class="post__meta">{d.read} de lectura · {fmt(d.pubDate)}{d.updatedDate && <> · Actualizado el {fmt(d.updatedDate)}</>}</span>
      <h1 class="post__h1">{d.title}</h1>
      <p class="post__intro">{d.description}</p>
      {/* LCP del artículo: nunca lazy. width/height = la caja renderizada (16/9,
          la portada se recorta con object-fit: cover), así no hay salto de layout.
          alt vacío a propósito: la portada es decorativa y el h1 de justo encima
          ya dice lo mismo — repetirlo solo molesta a quien usa lector de pantalla. */}
      <figure class="post__cover"><img src={d.cover} alt="" fetchpriority="high" decoding="async" width="1600" height="900" /></figure>
      <div class="post__body">
        <Content />
      </div>

      {d.faqs.length > 0 && (
        <section class="post__faq" aria-labelledby="faq-t">
          <h2 id="faq-t" class="post__faq-t">Preguntas frecuentes</h2>
          {d.faqs.map((f) => (
            <details class="post__q"><summary>{f.q}</summary><p>{f.a}</p></details>
          ))}
        </section>
      )}

      <aside class="post__cta">
        <h2 class="post__cta-t">¿Quieres una web así para tu negocio?</h2>
        <p>Diseño web y marca en Cantabria desde 299€. Una charla de 20 min y te digo qué necesitas — sin compromiso.</p>
        <div class="post__cta-btns">
          <a href="/precios/" class="btn btn--green">Ver precios →</a>
          <a href="/contacto/" class="btn btn--ghost">Hablar conmigo</a>
        </div>
      </aside>
    </div>
  </article>

  <style>
    .post__wrap { max-width: 760px; }
    .post__bc { font-family: var(--font-mono); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--ink-mute); margin-bottom: var(--s-4); }
    .post__bc a { color: var(--accent-ink); }
    .post__meta { font-family: var(--font-mono); font-size: 0.78rem; color: var(--accent-ink); text-transform: uppercase; letter-spacing: 0.06em; }
    .post__h1 { font-size: clamp(2.2rem, 5vw, 3.6rem); font-weight: 700; line-height: 1.0; margin: var(--s-3) 0 var(--s-4); }
    .post__intro { font-size: var(--fs-lead); color: var(--ink-soft); line-height: 1.4; margin-bottom: var(--s-5); }
    .post__cover { border-radius: var(--radius-lg); overflow: hidden; aspect-ratio: 16/9; margin-bottom: var(--s-6); }
    .post__cover img { width: 100%; height: 100%; object-fit: cover; }
    .post__body { font-size: 1.0625rem; line-height: 1.7; color: var(--ink); }
    .post__body :global(h2) { font-family: var(--font-display); font-weight: 700; font-size: clamp(1.5rem,3vw,2rem); margin: var(--s-6) 0 var(--s-3); line-height: 1.1; }
    .post__body :global(h3) { font-family: var(--font-display); font-weight: 700; font-size: 1.25rem; margin: var(--s-5) 0 var(--s-2); }
    .post__body :global(p) { margin-bottom: var(--s-4); }
    .post__body :global(ul), .post__body :global(ol) { margin: 0 0 var(--s-4) 1.2em; display: grid; gap: 8px; }
    .post__body :global(strong) { color: var(--ink); font-weight: 700; }
    .post__body :global(a) { color: var(--accent-ink); font-weight: 600; border-bottom: 1px solid currentColor; }
    .post__body :global(blockquote) { border-left: 3px solid var(--accent); padding-left: 18px; margin: var(--s-4) 0; color: var(--ink-soft); font-style: italic; }
    .post__faq { margin-top: var(--s-7); display: grid; gap: 12px; }
    .post__faq-t { font-family: var(--font-display); font-weight: 700; font-size: clamp(1.5rem,3vw,2rem); margin-bottom: var(--s-3); line-height: 1.1; }
    .post__q { background: var(--bg-2); border: 1px solid var(--line); border-radius: var(--radius); padding: clamp(16px,2vw,22px) clamp(18px,2.4vw,26px); }
    .post__q summary { font-family: var(--font-display); font-weight: 700; font-size: 1.05rem; cursor: pointer; list-style: none; display: flex; justify-content: space-between; gap: 14px; align-items: center; }
    .post__q summary::-webkit-details-marker { display: none; }
    .post__q summary::after { content: '+'; color: var(--accent-ink); font-size: 1.4rem; flex: none; transition: transform var(--dur) var(--ease-soft); }
    .post__q[open] summary::after { transform: rotate(45deg); }
    .post__q p { color: var(--ink-soft); line-height: 1.6; margin-top: 12px; }
    .post__cta { background: var(--panel); color: var(--panel-ink); border-radius: var(--radius-lg); padding: clamp(28px,4vw,44px); margin-top: var(--s-7); }
    .post__cta-t { font-family: var(--font-display); font-weight: 700; font-size: clamp(1.4rem,3vw,2rem); color: var(--panel-ink); margin-bottom: 10px; }
    .post__cta p { opacity: 0.85; margin-bottom: var(--s-4); max-width: 50ch; }
    .post__cta-btns { display: flex; flex-wrap: wrap; gap: 12px; }
    .post__cta .btn--ghost { background: rgba(255,255,255,0.1); border-color: rgba(255,255,255,0.25); color: #fff; }
  </style>
</Layout>
