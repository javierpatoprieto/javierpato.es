---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const fmt = (d: Date) => new Intl.DateTimeFormat('es-ES', { day: 'numeric', month: 'short', year: 'numeric' }).format(d);
---
<Layout
  title="Blog de diseño web y marca en Cantabria | Javier Pato"
  description="Guías y consejos sobre diseño web, diseño gráfico, branding y SEO local para negocios de Cantabria. Aprende a tener una web que venda."
>
  <section class="section blg">
    <div class="wrap">
      <header class="blg__head" data-reveal>
        <h1 class="blg__h1">Escribo.<br /><span class="blg__a">Bastante.</span></h1>
        <p class="blg__lead">Guías sin paja sobre diseño web, marca y SEO local para negocios de Cantabria. Lo que de verdad mueve la aguja.</p>
      </header>

      <div class="blg__grid" data-stagger>
        {posts.map((p) => (
          <a class="bcard" href={`/blog/${p.slug}`} data-reveal>
            <span class="bcard__cover"><img src={p.data.cover} alt={p.data.title} loading="lazy" /></span>
            <span class="bcard__meta">{p.data.read} · {fmt(p.data.pubDate)}</span>
            <h2 class="bcard__title">{p.data.title}</h2>
            <p class="bcard__desc">{p.data.description}</p>
            <span class="bcard__tags">{p.data.tags.slice(0, 2).map((t) => <span class="bcard__tag">{t}</span>)}</span>
            <span class="bcard__more">Leer más →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <style>
    .blg__head { display: grid; gap: var(--s-3); margin-bottom: var(--s-6); }
    .blg__h1 { font-size: clamp(2.6rem, 6vw, 5rem); font-weight: 700; line-height: 0.98; }
    .blg__a { color: var(--accent-ink); }
    .blg__lead { font-size: var(--fs-lead); color: var(--ink-soft); max-width: 54ch; }
    .blg__grid { display: grid; grid-template-columns: 1fr; gap: clamp(18px,2.4vw,28px); }
    .bcard { display: flex; flex-direction: column; background: var(--bg-2); border: 1px solid var(--line); border-radius: var(--radius); padding: 14px; transition: transform var(--dur) var(--ease); }
    .bcard:hover { transform: translateY(-5px); }
    .bcard__cover { aspect-ratio: 16/10; border-radius: 14px; overflow: hidden; margin-bottom: 14px; background: var(--bg); }
    .bcard__cover img { width: 100%; height: 100%; object-fit: cover; transition: transform var(--dur) var(--ease); }
    .bcard:hover .bcard__cover img { transform: scale(1.05); }
    .bcard__meta { font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--accent-ink); padding: 0 6px; }
    .bcard__title { font-family: var(--font-display); font-weight: 700; font-size: 1.3rem; line-height: 1.1; margin: 8px 6px; }
    .bcard__desc { color: var(--ink-soft); font-size: 0.95rem; margin: 0 6px 14px; flex: 1; }
    .bcard__tags { display: flex; gap: 8px; padding: 0 6px 6px; }
    .bcard__tag { font-size: 0.72rem; background: var(--bg); border: 1px solid var(--line); padding: 4px 10px; border-radius: var(--radius-pill); color: var(--ink-soft); }
    .bcard__more { margin: 12px 6px 4px; font-family: var(--font-display); font-weight: 700; font-size: 0.9rem; color: var(--accent-ink); transition: transform var(--dur) var(--ease); }
    .bcard:hover .bcard__more { transform: translateX(4px); }
    @media (min-width: 700px) { .blg__grid { grid-template-columns: 1fr 1fr; } }
    @media (min-width: 1040px) { .blg__grid { grid-template-columns: repeat(3, 1fr); } }
  </style>
</Layout>
