---
import Layout from '../layouts/Layout.astro';
import Work from '../components/Work.astro';
import Contact from '../components/Contact.astro';
---
<Layout
  title="Proyectos — Diseño web y marca en Cantabria | Javier Pato"
  description="Marcas y webs reales que he diseñado para negocios de Cantabria: hostelería, bienestar, servicios. Mira el trabajo y juzga tú."
>
  <section class="section pintro has-aura">
    <div class="wrap">
      <span class="pintro__k" data-reveal>Trabajo seleccionado</span>
      <h1 class="pintro__h" data-reveal>Trabajo que ya<br />está vendiendo.</h1>
      <p class="pintro__l" data-reveal>Marcas y webs reales para negocios de Cantabria. Sin relleno: lo que ves es lo que entrego.</p>
    </div>
  </section>
  <Work />
  <Contact />
  <style>
    .pintro { padding-top: clamp(36px, 6vw, 80px); padding-bottom: var(--s-6); }
    .pintro__k { font-family: var(--font-body); font-weight: 600; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.12em; color: var(--accent-ink); }
    .pintro__h { font-size: var(--fs-hero); font-weight: 800; line-height: 0.98; margin: var(--s-3) 0 var(--s-4); }
    .pintro__l { font-size: var(--fs-lead); color: var(--ink-soft); max-width: 50ch; }
  </style>
</Layout>
